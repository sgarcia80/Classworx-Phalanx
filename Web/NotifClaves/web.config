      </authorization>
    </system.web>
  </location>
  <microsoft.web.services3>
    <diagnostics>
      <trace enabled="false" input="c:\temp\InputTraceNotif.webinfo" output="c:\temp\OutputTraceNotif.webinfo"/>
      <detailedErrors enabled="false"/>
    </diagnostics>
    <policy fileName="wse3policyCache.config"/>
  </microsoft.web.services3>
