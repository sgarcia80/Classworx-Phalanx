		<add key="UsaProduccion" value="1"/>
		<add key="Version" value="2.8.2"/>
		<add key ="LDAPPath" value="LDAP://OU=Usuarios,DC=MACRO,DC=COM,DC=AR"/>
		<add key ="LDAPBuscarEmailFilter" value="(&amp;(objectCategory=person)(employeeID=[legajo]))"/>
		<add key ="LDAPBuscarNombreFilter" value="(&amp;(objectCategory=person)(samaccountname=[username]))"/>
		<add key ="PrefijoDescripcionUsuarioRed" value="# Phalanx # NO SE NOTIFICO #"/>
    <add key="HorasExpiracionToken" value="72"/>
	</appSettings>
	<connectionStrings>
