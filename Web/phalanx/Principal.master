<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Principal.master.cs" Inherits="Principal" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" >
<head runat="server">
    <title>Untitled Page</title>
		<LINK href="phalanx.css" type="text/css" rel="stylesheet">
</head>
<body>
<form id="form1" runat="server">
    <TABLE id="TableHeader" height="129" cellSpacing="0" cellPadding="0" width="100%" border="0">
	    <TR>
		    <TD width="83" height="129" rowSpan="3"><IMG alt="" src="./image/PhxHead1.gif"></TD>
		    <TD width="362" background="./image/PhxHead21.gif" height="80"></TD>
		    <td background="./image/PhxHead31.gif" height="80"></td>
		    <TD width="*" background="./image/PhxHead31.gif" height="80" vAlign="middle"
			    align="right">&nbsp;</TD>
		    <TD width="28" background="./image/PhxHead41.gif" height="80"></TD>
		    <TD width="13" background="./image/PhxHead51.gif" height="80"></TD>
	    </TR>
	    <TR>
		    <TD align="left" colspan="2" bgColor="#000080" height="20">
		        <asp:label id="LabelTitle" runat="server" ForeColor="#ffffff" Font-Size="12px" BackColor="Navy"
				    Font-Names="Tahoma" Font-Bold="True"></asp:label>
		    </TD>
		    <TD align="right" width="*" bgColor="#000080" height="20" noWrap>
		        <asp:label id="LabelUser" runat="server" ForeColor="#ffffff" Font-Size="XX-Small" BackColor="Navy"
				    Font-Names="Tahoma" Font-Bold="True"></asp:label>
            </TD>
		    <TD width="28" bgColor="#000080" height="20"></TD>
		    <TD width="13" background="./image/PhxHead52.gif" height="20"></TD>
	    </TR>
	    <TR>
		    <TD width="362" background="./image/PhxHead23.gif" height="29"></TD>
		    <TD width="*" colspan="2" background="./image/PhxHead33.gif" height="29"></TD>
		    <TD width="28" background="./image/PhxHead43.gif" height="29"></TD>
		    <TD width="13" background="./image/PhxHead53.gif" height="29"></TD>
	    </TR>
    </TABLE>    
    <table height="300px" cellSpacing="0" cellPadding="0" width="100%" border="0">
        <tr valign="top">
            <td valign="top">
                <asp:contentplaceholder id="ContentPlaceHolder1" runat="server">
                </asp:contentplaceholder>
            </td>
        </tr>
    </table>
    <asp:Table id="Table1" runat="server" Width="100%" Height="30px" CellPadding="0" CellSpacing="0"
	    BorderWidth="0px">
	    <asp:TableRow>
		    <asp:TableCell Height="46px" Width="125">
			    <asp:Image id="ImageF1" Width=125 Height=46 runat="server" ImageUrl="./image/PhxFoot1.gif"></asp:Image>
		    </asp:TableCell>
		    <asp:TableCell Height="46px">
			    <asp:Image id="ImageF2" Width=100% Height=46 runat="server" ImageUrl="./image/PhxFoot2.gif"></asp:Image>
		    </asp:TableCell>
		    <asp:TableCell Height="46px" Width="136px">
			    <asp:Image id="ImageF3" Width=136 Height=46 runat="server" ImageUrl="./image/PhxFoot3.gif"></asp:Image>
		    </asp:TableCell>
	    </asp:TableRow>
    </asp:Table>    
</form>
</body>
</html>
