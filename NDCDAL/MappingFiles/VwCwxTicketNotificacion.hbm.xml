<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-lazy="false">
  <class name="NDCCommon.Entities.TicketNotificacionEntity,NDCCommon" table="vwTicketNotificacionBlanqueo">

    <!-- could not find a primary key for this table/view. NHibernate requires an 'id' element, so you'll have to define one manually. -->
    <id name="Id" column="id" type="Int32" unsaved-value="0">
      <generator class="assigned"/>
    </id>

    <property column="tipo" type="String" name="Tipo"/>
    <property column="subtipo" type="String" name="Subtipo"/>
    <property column="numero" type="Int32" name="Numero"/>
    <property column="app_user" type="String" name="UsuarioAplicacion"/>
    <property column="user_red" type="String" name="Usuario"/>
    <property column="user_domain" type="String" name="Dominio"/>
    <property column="aplicacion" type="String" name="Aplicacion"/>
    <property column="fecha" type="DateTime" name="Fecha"/>

  </class>
  <sql-query name="GetNotificacionById">
    <return-scalar column="Tipo" type="String" />
    <return-scalar column="Subtipo" type="String" />
    <return-scalar column="Id" type="Int32" />
    <return-scalar column="Numero" type="Int32" />
    <return-scalar column="UsuarioAplicacion" type="String" />
    <return-scalar column="Usuario" type="String" />
    <return-scalar column="Dominio" type="String" />
    <return-scalar column="Aplicacion" type="String" />
    <return-scalar column="Fecha" type="DateTime" />

    exec SP_TICKETNOTIFICACION_ID :usuario, :id, :tipo
  </sql-query>
  <sql-query name="GetNotificacionByUser">
    <return-scalar column="Tipo" type="String" />
    <return-scalar column="Subtipo" type="String" />
    <return-scalar column="Id" type="Int32" />
    <return-scalar column="Numero" type="Int32" />
    <return-scalar column="UsuarioAplicacion" type="String" />
    <return-scalar column="Usuario" type="String" />
    <return-scalar column="Dominio" type="String" />
    <return-scalar column="Aplicacion" type="String" />
    <return-scalar column="Fecha" type="DateTime" />

    exec SP_TICKETNOTIFICACION_VIGENTE :usuario, :tipo, :fecha_desde, :fecha_hasta
  </sql-query>
</hibernate-mapping>