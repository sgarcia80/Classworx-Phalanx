		<Element Type="ISql90View" Name="[dbo].[vwHistPwdChg]">
			<Property Name="QueryScript">
				<Value><![CDATA[
SELECT     Id, Folio, Usuario COLLATE DATABASE_DEFAULT as Usuario, d_change, user_type_id, phx_user_id, password
FROM         dbo.vwHistChgApp
UNION
