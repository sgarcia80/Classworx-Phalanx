					<References Name="[dbo].[Users_Passwords].[pwd_lock_type_id]" />
				</Entry>
				<Entry>
					<References Name="[dbo].[Users_Passwords].[user_password_id]" />
				</Entry>
				<Entry>
					<References Name="[dbo].[Users_Passwords].[pwd_lock_type_id]" />
				</Entry>
				<Entry>
					<References Name="[dbo].[Users_Passwords]" />
				</Entry>
				<Entry>
					<References Name="[dbo].[Users_Passwords].[d_lock_pwd]" />
				</Entry>
				<Entry>
					<References Name="[dbo].[Users_Passwords].[user_password_id]" />
				</Entry>
			</Relationship>
