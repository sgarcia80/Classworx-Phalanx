<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="PhxADService.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <userSettings>
    <PhxADService.Properties.Settings>
      <setting name="PrefijoDescripcionUsuarioRed" serializeAs="String">
        <value># Phalanx # NO SE NOTIFICO #</value>
      </setting>
      <setting name="LDAPPath" serializeAs="String">
        <value>LDAP://CN=Users,DC=CwxTest</value>
      </setting>
      <setting name="FiltroBuscarNombreLDAP" serializeAs="String">
        <value>(&amp;(objectCategory=person)(sAMAccountName=[username]))</value>
      </setting>
    </PhxADService.Properties.Settings>
  </userSettings>
  <appSettings>
    <add key="LogLevel" value="0"/>
    <add key="LogFilePath" value="c:\classworx\phalanx\logs\phxLog.txt"/>
    <add key="UsaProduccion" value="1"/>
  </appSettings>
  <connectionStrings>
    <add name="NDC" providerName="System.Data.SqlClient" connectionString="MfrPersqnufDZHrfQ6Aci9b+xphDH9oOW7JUK4OENLtPJGNvGMApgGRibnjBSHRW" />
    <add name="NDCCont" providerName="System.Data.SqlClient" connectionString="C6ALQWXQINTuWlKvfY9EJzXUwDA1qWnJ9oIqChP/v2SZfVC3D4tdF2lfG7FE2e5ueDNV+E0Jjnk="/>
    <add name="Meta4" providerName="System.Data.SqlClient" connectionString="AI3p8OxmgyILHjAxbE/n4SQyTn+mMeMQXNbzbML8+Xx+HH2X7+vPwsy4AkIKWSaj"/>
    <add name="Meta4Cont" providerName="System.Data.SqlClient" connectionString="Dtllg/0njc9mnF55TBwh38utuzoVwGy580RfT0SDWsIWwiSH4JI14ovPfJvN7PKp3Vyhtd7glrU="/>
  </connectionStrings>
  <log4net>
    <appender name="rollingFile" type="log4net.Appender.RollingFileAppender,log4net">

      <param name="File" value="log.txt"/>
      <param name="AppendToFile" value="true"/>
      <param name="RollingStyle" value="Date"/>
      <param name="DatePattern" value="yyyy.MM.dd"/>
      <param name="StaticLogFileName" value="true"/>

      <layout type="log4net.Layout.PatternLayout,log4net">
        <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n"/>
      </layout>     
    </appender>
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline" />
      </layout>
    </appender>
    <root>
      <level value="ALL" />
      <appender-ref ref="rollingFile"/>
      <appender-ref ref="ConsoleAppender"/>
    </root>
    <logger name="NHibernate">
      <level value="ERROR" />
    </logger>

    <logger name="NHibernate.SQL">
      <level value="ERROR" />
    </logger>
  </log4net>
</configuration>