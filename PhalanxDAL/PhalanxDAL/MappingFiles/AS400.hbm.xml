<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-lazy="false">
	<class name="PhalanxCommon.Entities.AS400Entity,PhalanxCommon" table="AS400">

		<id name="Id" column="as_id" type="Int32" unsaved-value="0">
			<generator class="native"/>
		</id>
		<bag name="AS400UsersList" inverse="true" lazy="true" >
			<key column="as_id" />
			<one-to-many class="PhalanxCommon.Entities.AS400UserEntity,PhalanxCommon" />
		</bag>
		<property column="as_server_name" type="String" name="ServerName" not-null="true" length="100" />
		<property column="as_desc" type="String" name="Desc" length="200" />
		<property column="as_ip" type="String" name="Ip" length="15" />
		<property column="active" type="Boolean" name="Active" />

	</class>
</hibernate-mapping>
