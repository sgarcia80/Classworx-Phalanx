<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-lazy="false">
	<class name="PhalanxCommon.Entities.UserPasswordEntity,PhalanxCommon" table="Users_Passwords" dynamic-update="true">

		<id name="Id" column="user_password_id" type="Int32" unsaved-value="0">
			<generator class="native"/>
		</id>
		<bag name="UsersList" inverse="true" lazy="true" >
			<key column="user_password_id" />
			<one-to-many class="PhalanxCommon.Entities.UserEntity,PhalanxCommon" />
		</bag>
		<bag name="PasswordsRequestsList" inverse="true" lazy="true" >
			<key column="user_password_id" />
			<one-to-many class="PhalanxCommon.Entities.PasswordRequestEntity,PhalanxCommon" />
		</bag>
		<bag name="RqstGrpsPwdsList" inverse="true" lazy="true" >
			<key column="user_password_id" />
			<one-to-many class="PhalanxCommon.Entities.RqstGrpPwdEntity,PhalanxCommon" />
		</bag>
		<bag name="FollowupRqstGrpsPwdsList" inverse="true" lazy="true" >
			<key column="user_password_id" />
			<one-to-many class="PhalanxCommon.Entities.FollowupRequestGroupPasswordEntity,PhalanxCommon" />
		</bag>
		<property column="password" type="String" name="Password" length="550" />
		<property column="static_pwd" type="Boolean" name="StaticPwd" not-null="true" />
		<property column="d_next_change" type="DateTime" name="DNextChange" />
		<property column="d_last_change" type="DateTime" name="DLastChange" />
		<property column="change_freq" type="Decimal" name="ChangeFreq" />
		<property column="change_freq_unit" type="String" name="ChangeFreqUnit" length="1" />
		<property column="d_next_chk" type="DateTime" name="DNextChk" />
		<property column="d_last_chk" type="DateTime" name="DLastChk" />
		<property column="chk_freq" type="Decimal" name="ChkFreq" />
		<property column="chk_freq_unit" type="String" name="ChkFreqUnit" length="1" />
		<many-to-one name="PwdLockType" column="pwd_lock_type_id" class="PhalanxCommon.Entities.PwdLockTypeEntity,PhalanxCommon" />
		<property column="chk_pwd" type="Boolean" name="ChkPwd" not-null="true" />
		<property column="d_in_use_until" type="DateTime" name="DInUseUntil" />
		<property column="concurrent" type="Boolean" name="Concurrent" not-null="true" />
		<property column="checkeable" type="Boolean" name="Checkeable" not-null="true" />

	</class>
</hibernate-mapping>
