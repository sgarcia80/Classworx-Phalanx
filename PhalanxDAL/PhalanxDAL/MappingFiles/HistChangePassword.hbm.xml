<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-lazy="false">
	<class name="PhalanxCommon.Entities.HistPasswordChangeEntity,PhalanxCommon" table="hist_change_password" dynamic-update="true">

		<id name="Id" column="hist_chg_pwd_id" type="Int32" unsaved-value="0">
			<generator class="native"/>
		</id>
    <many-to-one name="User" column="user_id" class="PhalanxCommon.Entities.UserEntity,PhalanxCommon" />
    <many-to-one name="PhxUser" column="phx_user_id" class="PhalanxCommon.Entities.PhxUserEntity,PhalanxCommon" />
    <property column="d_change" type="DateTime" name="DChange" />
		<property column="password" type="String" name="Password" length="550" />
	</class>

  <sql-query name="DepurarLogCambioPassword">
    <return-scalar column="resultado" type="int"/>
    exec DepurarChangePasswordLog :fecha
  </sql-query>
</hibernate-mapping>
