<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-lazy="false">
	<class name="PhalanxCommon.Entities.RequestGroupEntity,PhalanxCommon" table="Requests_Groups">

		<id name="Id" column="rqst_grp_id" type="Int32" unsaved-value="0">
			<generator class="native"/>
		</id>
		<bag name="PhxUsersGroupsList" inverse="true" lazy="true" >
			<key column="rqst_grp_id" />
			<one-to-many class="PhalanxCommon.Entities.PhxUserGroupEntity,PhalanxCommon" />
		</bag>
		<bag name="RqstGrpsDelegList" inverse="true" lazy="true" >
			<key column="rqst_grp_id" />
			<one-to-many class="PhalanxCommon.Entities.RqstGrpDelegEntity,PhalanxCommon" />
		</bag>
		<bag name="RqstGrpsPwdsList" inverse="true" lazy="true" >
			<key column="rqst_grp_id" />
			<one-to-many class="PhalanxCommon.Entities.RqstGrpPwdEntity,PhalanxCommon" />
		</bag>
		<property column="rqst_grp_name" type="String" name="RqstGrpName" not-null="true" length="50" />
		<property column="rqst_grp_active" type="Boolean" name="Active" />

	</class>
</hibernate-mapping>
