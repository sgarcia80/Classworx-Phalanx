<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-lazy="false">
	<class name="PhalanxCommon.Entities.DatabaseTypeEntity,PhalanxCommon" table="Database_Types">

		<id name="Id" column="db_type_id" type="Int32" unsaved-value="0">
			<generator class="native"/>
		</id>
		<bag name="DataBasesList" inverse="true" lazy="true" >
			<key column="db_type_id" />
			<one-to-many class="PhalanxCommon.Entities.DataBaseEntity,PhalanxCommon" />
		</bag>
		<property column="db_type_code" type="String" name="Code" not-null="true" length="50" />
		<property column="db_type_name" type="String" name="Name" not-null="true" length="100" />
		
	</class>
</hibernate-mapping>
