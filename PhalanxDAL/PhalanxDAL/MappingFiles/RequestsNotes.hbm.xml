<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-lazy="false">
	<class name="PhalanxCommon.Entities.RequestNoteEntity,PhalanxCommon" table="Requests_Notes">

		<id name="Id" column="request_note_id" type="Int32" unsaved-value="0">
			<generator class="native"/>
		</id>
		<many-to-one name="Request" column="request_id" class="PhalanxCommon.Entities.RequestEntity,PhalanxCommon" />
		<many-to-one name="PhxUser" column="phx_user_id" class="PhalanxCommon.Entities.PhxUserEntity,PhalanxCommon" />
		<property column="request_note_date" type="DateTime" name="RequestNoteDate" not-null="true" />
		<property column="request_note_descrip" type="String" name="Descrip" not-null="true" length="200" />
		
	</class>
</hibernate-mapping>
