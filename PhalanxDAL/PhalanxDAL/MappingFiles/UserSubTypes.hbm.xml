<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" default-lazy="false">
	<class name="PhalanxCommon.Entities.UserSubTypeEntity, PhalanxCommon" table="User_SubTypes">

		<id name="Id" column="user_subtype_id" type="Int32" unsaved-value="0">
			<generator class="native"/>
		</id>
		<bag name="UsersList" inverse="true" lazy="true" >
			<key column="user_subtype_id" />
			<one-to-many class="PhalanxCommon.Entities.UserEntity, PhalanxCommon" />
		</bag>
		<property column="user_subtype_desc" type="String" name="Desc" not-null="true" length="50" />
		
	</class>
</hibernate-mapping>
