		<property column="dc_type" type="String" name="Type" not-null="true" length="1" />
		<many-to-one name="WinPc" column="win_pc_id" class="PhalanxCommon.Entities.WinPCEntity,PhalanxCommon" />
		<many-to-one name="ImpersonateUser" column="impersonate_user_id" class="PhalanxCommon.Entities.WinDomainUserEntity,PhalanxCommon" />
		
	</class>
</hibernate-mapping>
