<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="TestWSInterfaceClaves.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
    </sectionGroup>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>
  <connectionStrings>
    <add name="Meta4" providerName="System.Data.SqlClient" connectionString="jqsLPTXKB6yRvoN8xP8qgDXweO30bZH2GUADukC/r7y8V5+Cl5Dyv0SwcaRU4BEFjMPiIQlaJ1ufF8fncpPdaQ==" />
    <add name="Meta4Cont" providerName="System.Data.SqlClient" connectionString="jqsLPTXKB6yRvoN8xP8qgDXweO30bZH2GUADukC/r7y8V5+Cl5Dyv0SwcaRU4BEFjMPiIQlaJ1ufF8fncpPdaQ==" />
  </connectionStrings>
  <appSettings>
    <add key="UsaProduccion" value="1" />
    <add key="Version" value="2.6"/>
    <add key="DebugChgAD" value="1"/>
    <!--<add key ="LDAPPath" value="LDAP://DCBA01.macro.com.ar/OU=pruebas,OU=Usuarios,DC=MACRO,DC=COM,DC=AR"/>-->
    <add key="LDAPPath" value="LDAP://CN=Users,DC=CwxTest"/>
    <add key="LDAPBuscarNombreFilter" value="(&amp;(objectCategory=person)(sAMAccountName=[username]))"/>
    <add key="PrefijoDescripcionUsuarioRed" value="# Phalanx # NO SE NOTIFICO #"/>
  </appSettings>
  <applicationSettings>
    <TestWSInterfaceClaves.Properties.Settings>
      <setting name="TestWSInterfaceClaves_ConectoresWS_UsuarioService"
        serializeAs="String">
        <value>http://localhost:23587/UsuarioService.asmx</value>
      </setting>
      <setting name="TestWSInterfaceClaves_WSTickets_TicketsDeClaves"
        serializeAs="String">
        <value>http://localhost:8001/TicketsDeClaves.asmx</value>
      </setting>
    </TestWSInterfaceClaves.Properties.Settings>
  </applicationSettings>
  <log4net>
    <appender name="MemoryAppender" type="log4net.Appender.MemoryAppender">
      <layout type="log4net.Layout.PatternLayout,log4net">
        <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n "/>
      </layout>
    </appender>
    <appender name="rollingFile" type="log4net.Appender.RollingFileAppender,log4net">

      <param name="File" value="log.txt"/>
      <param name="AppendToFile" value="true"/>
      <param name="RollingStyle" value="Date"/>
      <param name="DatePattern" value="yyyy.MM.dd"/>
      <param name="StaticLogFileName" value="true"/>

      <layout type="log4net.Layout.PatternLayout,log4net">
        <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n"/>
      </layout>
    </appender>
    <root>
      <level value="ALL"/>
      <appender-ref ref="MemoryAppender"/>
      <appender-ref ref="rollingFile"/>
    </root>
  </log4net>

  <system.diagnostics>
    <sources>
      <source name="Classworx.Common.Trace" switchValue="Information, Warning, Error">
        <listeners>
          <add name="Default" type="System.Diagnostics.DefaultTraceListener" />
          <add name="fileTrace">
            <filter type="" />
          </add>
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add initializeData="C:\Working Folder\Classworx\Macro\Logs\TestCwx.log" type="Classworx.Common.Trace.GenericHealthModelTraceListener, Classworx.Common.Trace" name="fileTrace">
        <filter type="" />
      </add>
    </sharedListeners>
    <trace autoflush="true" />
  </system.diagnostics>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
</configuration>
